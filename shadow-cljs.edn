{:source-paths ["src" "test"]

 ;; ClojureScript libraries come from Maven/Clojars; JavaScript from npm.
 :dependencies [[reagent "1.2.0"]]

 ;; `npm run dev` serves public/ here.
 :dev-http {8080 "public"}

 :builds
 {:app  {:target     :browser
         :output-dir "public/js"
         :asset-path "js"
         :modules    {:main {:init-fn habits.main/init}}
         :release    {:compiler-options {:infer-externs :auto}}}

  :test {:target    :node-test
         :output-to "out/test.js"
         :ns-regexp "-test$"}}}
